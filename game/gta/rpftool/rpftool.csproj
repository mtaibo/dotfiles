<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- CodeWalker is cloned inside this folder; keep its sources and resources out of this project -->
    <DefaultItemExcludes>$(DefaultItemExcludes);CodeWalker/**;out/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="CodeWalker/CodeWalker.Core/CodeWalker.Core.csproj" />
  </ItemGroup>
</Project>
